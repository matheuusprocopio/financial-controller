# Postgres: aceita postgres://usuario:senha@host:5432/banco ou jdbc:postgresql://host:5432/banco
# Banco local do compose (--profile local-db): use host "db" ao rodar a API no Docker
# e "localhost" ao rodar a API com mvn/java direto na máquina
DB_URL=postgresql://postgres:postgres@db:5432/financial_controller
# Necessários apenas se usuário/senha não estiverem na DB_URL
DB_USER=
DB_PASSWORD=

# Firebase Admin: preencha UMA das opções abaixo
# Opção 1: JSON da service account em uma única linha
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opção 2: caminho do arquivo da service account (salve-o como back-end/service-account-key.json)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
FIREBASE_PROJECT_ID=

# OpenAI (embeddings)
OPENAI_API_KEY=
# Opcional: endpoint alternativo de embeddings
OPENAI_API_URL=

# CORS: origens do front-end liberadas, separadas por vírgula
# Em produção, inclua a URL da Vercel (ex.: https://financial-controller.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: porta da API (padrão 8080; o Render define automaticamente)
PORT=
